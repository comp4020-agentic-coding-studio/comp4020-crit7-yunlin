---
import { nextBoundaryDelayMinutes } from "../lib/clock";
import { listBookingsForDate, listRooms } from "../lib/db";
import "../styles.css";

// All times on this board are Canberra wall-clock text (see src/lib/schema.ts)
// — "now" has to be read the same way, regardless of what timezone the
// machine running the server happens to be in.
function canberraParts(d = new Date()) {
  const fmt = new Intl.DateTimeFormat("en-CA", {
    timeZone: "Australia/Canberra",
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
    hour: "2-digit",
    minute: "2-digit",
    hour12: false,
  });
  const parts = Object.fromEntries(fmt.formatToParts(d).map((p) => [p.type, p.value]));
  return { date: `${parts.year}-${parts.month}-${parts.day}`, time: `${parts.hour}:${parts.minute}` };
}

function shiftDate(base: string, days: number): string {
  const d = new Date(`${base}T00:00:00Z`);
  d.setUTCDate(d.getUTCDate() + days);
  return d.toISOString().slice(0, 10);
}

const { date: today, time: nowTime } = canberraParts();
const requestedDate = Astro.url.searchParams.get("date");
const date = requestedDate && /^\d{4}-\d{2}-\d{2}$/.test(requestedDate) ? requestedDate : today;
const isToday = date === today;
const error = Astro.url.searchParams.get("error");

const errorMessages: Record<string, string> = {
  conflict: "That room is already booked for part of this time — pick another slot.",
  date: "That's not a date the board understands — pick one from the calendar.",
  invalid: "The end time has to be after the start time.",
  name: "Enter your name so the room knows who's got it.",
  room: "Pick a room.",
};

const rooms = listRooms();
const bookingsForDate = listBookingsForDate(date);
// Whether "now" falls inside a booking is decided here, in plain TS, and
// carried on the data — the Astro compiler reads a bare `<` inside a JSX-like
// expression as the start of a tag, so that comparison can't live inline in
// the template below.
const isNowWithin = (start: string, end: string) => isToday && start <= nowTime && nowTime < end;
const roomsWithBookings = rooms.map((room) => ({
  room,
  bookings: bookingsForDate
    .filter((b) => b.roomId === room.id)
    .map((b) => ({ ...b, active: isNowWithin(b.startTime, b.endTime) })),
}));

// Passed to the client script below so a tab left open across a booking's
// start/end minute reloads itself right then, instead of only when some
// other tab's booking happens to trigger the SSE reload.
const nextBoundaryDelay = isToday
  ? nextBoundaryDelayMinutes(nowTime, bookingsForDate.flatMap((b) => [b.startTime, b.endTime]))
  : null;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="A live board for ANU Library group study rooms — book a slot, see who's got a room right now, cancel one you don't need."
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Room board</title>
  </head>
  <body>
    <nav aria-label="site">
      <a href="/">Room board</a>
      <a href="/readme/">About</a>
    </nav>
    <main>
      <h1>Room board</h1>
      <p>
        A shared, live view of a handful of ANU Library group study rooms: who's booked what, and what's free — see
        the <a href="/readme/">README</a> for what this prototype is standing in for.
      </p>

      <nav aria-label="date">
        <a href={`/?date=${shiftDate(date, -1)}`}>&larr; {shiftDate(date, -1)}</a>
        <strong>{date}{isToday ? " (today)" : ""}</strong>
        <a href={`/?date=${shiftDate(date, 1)}`}>{shiftDate(date, 1)} &rarr;</a>
      </nav>

      {error && (
        <p class="error" role="alert">
          {errorMessages[error] ?? "Something went wrong — try again."}
        </p>
      )}

      <div class="rooms">
        {roomsWithBookings.map(({ room, bookings }) => (
          <section class="room" aria-labelledby={`room-${room.id}`}>
            <h2 id={`room-${room.id}`}>{room.name}</h2>
            <ul>
              {bookings.length === 0 && <li class="empty">Free all day</li>}
              {bookings.map((booking) => (
                <li class={booking.active ? "active" : undefined}>
                  <span class="time">
                    {booking.startTime}–{booking.endTime}
                  </span>
                  <span class="who">{booking.bookedBy}</span>
                  <form method="post" action={`/api/bookings/${booking.id}/cancel`}>
                    <input type="hidden" name="date" value={date} />
                    <button type="submit">Cancel</button>
                  </form>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>

      <form method="post" action="/api/bookings" class="book-form">
        <h2>Book a room</h2>
        <input type="hidden" name="date" value={date} />
        <div>
          <label for="roomId">Room</label>
          <select id="roomId" name="roomId" required>
            {rooms.map((room) => (
              <option value={room.id}>{room.name}</option>
            ))}
          </select>
        </div>
        <div>
          <label for="bookedBy">Your name</label>
          <input id="bookedBy" name="bookedBy" required maxlength="80" />
        </div>
        <div>
          <label for="startTime">From</label>
          <input id="startTime" name="startTime" type="time" required />
        </div>
        <div>
          <label for="endTime">To</label>
          <input id="endTime" name="endTime" type="time" required />
        </div>
        <button>Book {date}</button>
      </form>
    </main>
    <script is:inline define:vars={{ date, nextBoundaryDelay }}>
      // The board's live half: any tab looking at this same date reloads the
      // moment a booking is made or cancelled anywhere, so two people looking
      // at the same day never work from stale information. The form itself
      // needs none of this — its own POST + redirect already re-renders from
      // SQLite.
      const source = new EventSource("/api/events");
      source.addEventListener("booking", (event) => {
        const payload = JSON.parse(event.data);
        if (payload.date === date) location.reload();
      });

      // The other half of "live": the "happening now" highlight is computed
      // once, at render time. With no other tab ever booking or cancelling
      // anything today, this tab would otherwise keep showing that render's
      // answer forever, even long after the slot it highlights has ended.
      // `nextBoundaryDelay` (minutes to the next booking start/end today) is
      // computed server-side in plain Canberra-clock minute arithmetic — no
      // client-side timezone handling needed — so this only ever fires once,
      // right when the page's own answer would go stale.
      if (nextBoundaryDelay !== null) {
        setTimeout(() => location.reload(), nextBoundaryDelay * 60_000 + 5_000);
      }
    </script>
  </body>
</html>
